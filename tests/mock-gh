#!/usr/bin/env python3
import json
from pathlib import Path
import subprocess
import sys
root=Path(__file__).resolve().parent
registry=root/'prs.json'
args=sys.argv[1:]
state=json.loads(registry.read_text()) if registry.exists() else []
def option(name, default=None):
    return args[args.index(name)+1] if name in args else default
def oid(branch):
    return subprocess.check_output(['git','--git-dir',str(root/'remote.git'),'rev-parse','refs/heads/'+branch],text=True).strip()
def emit(data):
    fields=option('--json')
    if fields:
        keys=fields.split(',')
        if isinstance(data,list): data=[{k:r.get(k) for k in keys} for r in data]
        else: data={k:data.get(k) for k in keys}
    print(json.dumps(data))
for row in state:
    row['headRefOid']=oid(row['headRefName'])
if args[:2]==['auth','status']:
    print('Mock authenticated; no network used.')
elif args[:2]==['repo','view']:
    emit({'nameWithOwner':'fixture/stacked-eval','defaultBranchRef':{'name':'main'}})
elif args[:2]==['pr','list']:
    rows=[r for r in state if (not option('--head') or r['headRefName']==option('--head')) and (not option('--base') or r['baseRefName']==option('--base'))]
    emit(rows)
elif args[:2]==['pr','create']:
    head=option('--head'); base=option('--base')
    assert head and base, 'Explicit head and base required'
    assert not any(r['headRefName']==head for r in state), 'PR already exists'
    oid(base)
    row={'number':len(state)+1,'headRefName':head,'baseRefName':base,'headRefOid':oid(head),'state':'OPEN','url':f'https://example.invalid/pull/{len(state)+1}','title':option('--title'),'body':Path(option('--body-file')).read_text() if option('--body-file') else option('--body',''),'isDraft':'--draft' in args}
    state.append(row)
    registry.write_text(json.dumps(state,indent=2))
    print(row['url'])
elif args[:2] in (['pr','view'],['pr','edit']):
    target=args[2] if len(args)>2 and not args[2].startswith('-') else subprocess.check_output(['git','branch','--show-current'],text=True).strip()
    row=next(r for r in state if target in (str(r['number']),r['url'],r['headRefName']))
    if args[1]=='edit':
        for flag,key in [('--base','baseRefName'),('--title','title'),('--body','body')]:
            if option(flag): row[key]=option(flag)
        if option('--body-file'): row['body']=Path(option('--body-file')).read_text()
        registry.write_text(json.dumps(state,indent=2))
    emit(row)
else:
    raise SystemExit('Unsupported mock command: '+repr(args))
